# CivicSaathi AI Environment Configuration
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit your real .env file or real API keys to version control.

# Google Gemini API key (Required for real AI image analysis; simulated fallback used if unset)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini model for vision and tool calling
# Recommended: gemini-3.1-flash-lite (fast, supports structured vision input)
GEMINI_MODEL=gemini-3.1-flash-lite

# HTTP server port (default: 8080)
PORT=8080

# SQLite database path (default: ./data/civicsaathi.db)
DB_PATH=./data/civicsaathi.db

# Directory for storing uploaded complaint photos
UPLOAD_DIR=./data/uploads

# Comma-separated allowed origins for cross-origin API calls (leave empty for same-origin)
CORS_ORIGIN=
